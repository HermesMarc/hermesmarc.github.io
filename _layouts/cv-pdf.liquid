---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">Curriculum Vitae</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv-pdf-embed">
      {% assign pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      
      <!-- Fallback options -->
      <div style="margin-top: 10px;">
        <p>If you're having trouble viewing the document, you can also <a href="{{ pdf_url }}" download>download the PDF here.</a></p>
      </div>

      <!-- iframe embed -->
      <iframe src="{{ pdf_url }}" width="100%" height="800px" style="border: none;">
        <!-- Fallback for browsers that don't support iframes -->
        <p>Your browser does not support iframes. You can <a href="{{ pdf_url }}">download the PDF here</a>.</p>
      </iframe>
    </div>
  </article>
</div>
